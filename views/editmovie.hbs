
<!DOCTYPE html>
<html>
<head>
    <title>Edit Movie</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <nav class="navbar">

        <h1 class="logo">NETFLIX</h1>

        <div class="nav-buttons">
            <a href="/movie/" class="btn">Back Home</a>
            <a href="/auth/logout" class="btn">Logout</a>
        </div>

    </nav>

    <div class="form-container">

        <h1>Update Movie Details</h1>

        <form action="/movie/update/{{data._id}}"
              method="POST"
              enctype="multipart/form-data">

            <label>Movie Title</label>
            <input type="text" name="title"
                   value="{{data.title}}" required>

            <label>Release Year</label>
            <input type="number" name="year"
                   value="{{data.year}}" required>

            <label>Duration</label>
            <input type="text" name="duration"
                   value="{{data.duration}}" required>

            <label>Rating</label>
            <input type="number" name="rating"
                   value="{{data.rating}}"
                   min="0" max="10" step="0.1" required>

            <label>Language</label>
            <input type="text" name="language"
                   value="{{data.language}}" required>

            <label>Description</label>
            <textarea name="description">{{data.description}}</textarea>

            <!-- Existing Movie Poster -->
            <label>Current Movie Poster</label>

            <div class="edit-poster">
                {{#if data.movieposter}}
                    <img src="{{data.movieposter}}" alt="Current Movie Poster">
                {{else}}
                    <p>No poster available</p>
                {{/if}}
            </div>

            <!-- Upload New Poster -->
            <label>Choose New Movie Poster</label>

            <input type="file"
                   name="movie-poster"
                   accept="image/*">

            <button type="submit">Update Movie</button>

        </form>

    </div>

</body>
</html>
