
<!DOCTYPE html>
<html>
<head>
    <title>Add Movie</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

 <nav class="navbar">

    <h1 class="logo">NETFLIX</h1>

    <div class="nav-buttons">
        <a href="/movie/" class="btn">Back Home</a>
        <a href="/auth/logout" class="btn">Logout</a>
    </div>

</nav>

    <div class="form-container">

        <h1>Add New Movie</h1>

        <form action="/movie/add" method="POST" enctype="multipart/form-data">

            <label>Movie Title</label>
            <input type="text" name="title"
                   placeholder="Enter movie title" required>


            <label>Release Year</label>
            <input type="number" name="year"
                   placeholder="Enter release year" required>

            <label>Duration</label>
            <input type="text" name="duration"
                   placeholder="Example: 2h 30m" required>

            <label>Rating</label>
            <input type="number" name="rating"
                   min="0" max="10" step="0.1"
                   placeholder="Enter rating" required>

            <label>Language</label>
            <input type="text" name="language"
                   placeholder="Enter language" required>

            <label>Description</label>
            <textarea name="description"
                      placeholder="Enter movie description"
                      ></textarea>

<label>Movie Poster</label>
    <input type="file"
           name="movie-poster"
           accept="image/*"
           required>

            <button type="submit">Add Movie</button>

        </form>

    </div>

</body>
</html>
